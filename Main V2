

import javax.swing.*;
import entity.Tile;
import entity.Player;
import java.awt.*;
import java.awt.event.*;


public class Main extends JPanel implements KeyListener {
    // ===== WINDOW SETTINGS =====

    static final int WIDTH = 800;
    static final int HEIGHT = 600;
    
    Timer gameTimer;

    // ===== GAME STATES =====

    final int WELCOME = 0;
    final int PLAYING = 1;
    final int WIN = 2;
    
    int gameState = WELCOME;
  
    // ===== PLAYER VARIABLES =====
    
    Player player1;
    Image playerPic;
    
    //background tiles
    Tile[][] tiles;

    // ===== MAIN METHOD =====

    public static void main(String[] args) {
        JFrame window = new JFrame("Colour Smash");

        Main gamePanel = new Main();

        window.add(gamePanel);
        window.setSize(WIDTH, HEIGHT);
        window.setResizable(false);
        window.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        window.setVisible(true);

        window.addKeyListener(gamePanel);
    } // main

    // ===== CONSTRUCTOR =====

    public Main() {
        setBackground(Color.GREEN);
        
        
        //load image
        Toolkit tk = Toolkit.getDefaultToolkit();
        playerPic = tk.getImage("redPaintBrush.png");
        
        //initialize player1
        player1 = new Player();
        
        //initialize tiles
        tiles = new Tile[300][200];
        for(int i = 0; i < tiles.length; i++) {
        	for(int j = 0; j < tiles[i].length; j++) {
				tiles[i][j] = new Tile();
				tiles[i][j].setColour(Color.RED);
				tiles[i][j].setX(i * (Tile.WIDTH+1));
				tiles[i][j].setY(j * (Tile.HEIGHT+1));	
        	}//for
        }//for
        
        // Game loop runs every 50 ms (~20 FPS)
        gameTimer = new Timer(50, new ActionListener() {
            public void actionPerformed(ActionEvent e) {
               gameLoop();
            }
        });

        gameTimer.start(); // start loop
       
    }

    // ===== DRAW SCREEN =====

    public void paintComponent(Graphics g){
        super.paintComponent(g);

        // ===== WELCOME SCREEN =====
        if (gameState == WELCOME) {
            g.setFont(new Font("Arial", Font.BOLD, 34));
            g.setColor(Color.blue);
            g.drawString("COIN COLLECTOR", 240, 220);

            g.setFont(new Font("Arial", Font.PLAIN, 24));
            g.setColor(Color.black);
            g.drawString("Use Arrow Keys to Move", 250, 300);
            g.drawString("Press SPACE to Start", 270, 350);
        }

        // ===== PLAY SCREEN =====
        else if (gameState == PLAYING) {
        	
        	//draw tiles
        	for(int i = 0; i < tiles.length; i++) {
            	for(int j = 0; j < tiles[i].length; j++) {
                	g.setColor(tiles[i][j].getColour());
            		g.fillRect(tiles[i][j].x, tiles[i][j].y, Tile.WIDTH, Tile.HEIGHT);	
            	}
            }
        	
            // Draw player
            g.setColor(Color.blue);
            g.drawImage(playerPic, player1.x, player1.y, player1.size, player1.size, this);
        }

        // ===== WIN SCREEN =====
        else if (gameState == WIN) {
            g.setFont(new Font("Arial", Font.BOLD, 36));
            g.setColor(Color.red);
            g.drawString("YOU WIN!", 290, 240);
        } // win screen
    } // paintComponent

    // ===== KEY PRESS =====

    public void keyPressed(KeyEvent e) {
        // SPACE starts or restarts game
        if (e.getKeyCode() == KeyEvent.VK_SPACE) {
            startGame();
        }

        // Only move during gameplay
        if (gameState == PLAYING) {
        	 if (e.getKeyCode() == KeyEvent.VK_LEFT) {
                 player1.movePlayerLeft();
             }

             if (e.getKeyCode() == KeyEvent.VK_RIGHT) {
             	player1.movePlayerRight();
             }

             if (e.getKeyCode() == KeyEvent.VK_UP){
             	player1.movePlayerUp();
             }

             if (e.getKeyCode() == KeyEvent.VK_DOWN) {
             	player1.movePlayerDown();
             }
            
        	for(int i = 0; i < tiles.length; i++) {
            	for(int j = 0; j < tiles[i].length; j++) {
            		colourTile(tiles[i][j]);
            	}
        	}

            keepPlayerOnScreen();
        } // if

        repaint();
    } // keyPressed

    public void keyReleased(KeyEvent e){}

    public void keyTyped(KeyEvent e){}

    // ===== GAME LOGIC =====

    public void startGame() {

        player1.x = 100;
        player1.y = 100;

    	gameState = PLAYING;
    	repaint();
    	
    } // startGame


    // ===== CHECK COLLISION =====

    	public void colourTile(Tile tile) {
    
    	if(((player1.x - tile.x > -player1.size && player1.x - tile.x < Tile.WIDTH) && (player1.y - tile.y > -player1.size && player1.y - tile.y < Tile.HEIGHT))) {
    		tile.setColour(Color.BLUE);
    	}//if
    	
    } // colourTile

    // ===== KEEP PLAYER ON SCREEN =====

    public void keepPlayerOnScreen() {

    	if(player1.x < 0) {
    		player1.x = 0;
    	}
    	
    	if(player1.x > WIDTH - (20 + player1.size)) {
    		player1.x = WIDTH - (20 + player1.size);
    	}
    	
    	if(player1.y < 0) {
    		player1.y = 0;
    	}
    	
    	if(player1.y > HEIGHT - 2*player1.size) {
    		player1.y = HEIGHT - 2*player1.size;
    	}

    } // keepPlayerOnScreen
    
    public void gameLoop() {
        if (gameState == PLAYING) {

        }

        repaint(); // redraw screen every frame
    } // gameLoop
} // class
