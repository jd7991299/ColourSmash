        		g.drawString("Red Player - WASD", 280, 330);
        		g.setColor(Color.BLUE);
        		g.drawString("Blue Player - Arrows ", 275, 380);
        		g.setColor(Color.BLACK);
        		g.drawString("Press Space to start", 270, 450);
            }//if
    	}//if
        		
        // ===== PLAY SCREEN =====
        else if (gameState == PLAYING) {
        	//draw tiles
        	for(int i = 0; i < tiles.length; i++) {
            	for(int j = 0; j < tiles[i].length; j++) {
                	g.setColor(tiles[i][j].getColour());
            		g.fillRect(tiles[i][j].x, tiles[i][j].y, Tile.SIZE, Tile.SIZE);	
            	}//for
            }//for
        	
            // Draw player
            g.drawImage(player[0].currentImage, player[0].x, player[0].y, player[0].size, player[0].size, this);
            g.drawImage(player[1].currentImage, player[1].x, player[1].y, player[1].size, player[1].size, this);
            
