package entity;

import java.awt.Image;

public class Powerup {
		public int x = 0;
		public int y = 0;
		public int type = 0;
		public int size = 40;
		public Image bigPowerup, speedPowerup, colourBomb;
		public Image currentImage;
		
		//set image depending on the powerup type
	    public void setCurrentImage() {
	    	if(type == 1) {
	    		this.currentImage = bigPowerup;
	    	} else if(type == 2) {
	    		this.currentImage = speedPowerup;
	    	} else {
	    		this.currentImage = colourBomb;
	    	}//if
	    }//setCurrentImage
}//class
