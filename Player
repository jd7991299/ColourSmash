package entity;

public class Player {

    // ===== PLAYER VARIABLES =====

    public int x = 100;
    public int y = 100;
    public int size = 40;
    public int moveAmount = 15;
    
    public Player() {
    	
    }
    public void movePlayerRight() {
    	this.x += moveAmount;
    }
    
    public void movePlayerLeft() {
    	this.x -= moveAmount;
    }
    
    public void movePlayerUp() {
    	this.y -= moveAmount;
    }
    
    public void movePlayerDown() {
    	this.y += moveAmount;
    }
    

}
