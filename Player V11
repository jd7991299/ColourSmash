package entity;

import java.awt.Color;
import java.awt.Image;

public class Player {
    // ===== PLAYER VARIABLES =====
    public int x = 0;
    public int y = 0;
    public int size = 60;
    public int moveAmount = 2;
    public Color colour;
    public boolean up, down, left, right;
    public Image imageUp, imageDown, imageLeft, imageRight;
    public Image currentImage;
    
    public void movePlayerRight() {
    	this.x += moveAmount;
    }//movePlayerRight
    
    public void movePlayerLeft() {
    	this.x -= moveAmount;
    }//movePlayerLeft
    
    public void movePlayerUp() {
    	this.y -= moveAmount;
    }//movePlayerUp
    
    public void movePlayerDown() {
    	this.y += moveAmount;
    }//movePlayerDown
}//class
